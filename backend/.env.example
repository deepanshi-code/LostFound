# Copy to .env and fill in
PORT=4000
# Use a long random string in any shared/deployed environment
JWT_SECRET=change-me-to-a-long-random-string
# Only these email domains can sign up (comma-separated, e.g. geu.ac.in,gehu.ac.in). Empty = anyone.
ALLOWED_EMAIL_DOMAIN=

# Email (for verification and password-reset codes).
# On hosts that block SMTP (e.g. Render free), use Brevo instead: BREVO_API_KEY plus MAIL_FROM set to a sender
# address you verified in Brevo. BREVO_API_KEY takes priority over SMTP_*.
BREVO_API_KEY=
# Leave empty during development: codes are printed in the backend terminal instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASS=a 16-character App Password (Google Account > Security > App passwords; needs 2-Step Verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional display name/address, e.g. Campus Lost & Found <you@gmail.com>
MAIL_FROM=

# Permanent storage (optional locally; required on hosts with a temporary disk like Render free)
# Without DATABASE_URL the API uses PGlite, an embedded Postgres saved in backend/data/pgdata.
# Supabase: Connect → Connection string → "Session pooler" URI (works from IPv4-only hosts such as Render)
DATABASE_URL=
# Supabase Storage for photos (Project URL and a secret / service_role key). Without these, photos go to backend/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=item-photos
