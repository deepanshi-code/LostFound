# Copy to .env and fill in
PORT=4000
# Use a long random string in any shared/deployed environment
JWT_SECRET=change-me-to-a-long-random-string
# Only these email domains can sign up (comma-separated, e.g. geu.ac.in,gehu.ac.in). Empty = anyone.
ALLOWED_EMAIL_DOMAIN=

# Email (for verification and password-reset codes).
# Leave empty during development: codes are printed in the backend terminal instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASS=a 16-character App Password (Google Account > Security > App passwords; needs 2-Step Verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional display name/address, e.g. Campus Lost & Found <you@gmail.com>
MAIL_FROM=
